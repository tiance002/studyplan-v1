      "StageResourceRole": {
        "description": "阶段与资源的关系角色（设计 §2.2）。\n\n每阶段默认一条 ``PRIMARY`` 主线；``SUPPLEMENT`` 补充前置，\n``REFERENCE`` 为对照/延伸。**不计算章节重叠率或覆盖率。**",
        "enum": [
          "primary",
          "supplement",
          "reference"
        ],
        "title": "StageResourceRole",
        "type": "string"
      },
      "StageResourceAssignmentView": {
        "description": "阶段 → 资源分配。``role=primary`` 表示该阶段主线。\n\n``ordered_sections`` 保持原始顺序；无核验链接时用\n``fallback_search_terms`` 给出搜索建议，**绝不编造 URL**。",
        "properties": {
          "assignment_id": {
            "maxLength": 64,
            "title": "Assignment Id",
            "type": "string"
          },
          "stage_id": {
            "maxLength": 64,
            "title": "Stage Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StageResourceRole"
          },
          "creator": {
            "default": "",
            "description": "主线作者/机构",
            "maxLength": 200,
            "title": "Creator",
            "type": "string"
          },
          "source_ref": {
            "default": "",
            "description": "公共资源来源 source_id",
            "maxLength": 64,
            "title": "Source Ref",
            "type": "string"
          },
          "source_version": {
            "default": 0,
            "minimum": 0,
            "title": "Source Version",
            "type": "integer"
          },
          "ordered_sections": {
            "items": {
              "$ref": "#/components/schemas/OrderedSection"
            },
            "title": "Ordered Sections",
            "type": "array"
          },
          "fallback_search_terms": {
            "items": {
              "type": "string"
            },
            "title": "Fallback Search Terms",
            "type": "array"
          }
        },
        "required": [
          "assignment_id",
          "stage_id",
          "role"
        ],
        "title": "StageResourceAssignmentView",
        "type": "object"
      },
      "KnowledgeExtensionView": {
        "description": "阶段预置扩展知识（默认 1–2 项，**可选**，不强制完成）。",
