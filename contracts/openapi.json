{
  "openapi": "3.1.0",
  "info": {
    "title": "studyplan API",
    "description": "学习规划助手 V1.1 —— LangGraph 编排 + FastAPI 接入 + PostgreSQL 业务事实源。\n\n**契约真相源是 Pydantic 模型**，本 OpenAPI 是其导出物（ADR-0004）。\n**AuthContext 永不出现在可写请求体**，由服务端会话派生。",
    "version": "1.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Healthz",
        "description": "健康检查。**不暴露**图版本以外的内部信息。",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "additionalProperties": false,
        "description": "统一错误视图：``code/message/request_id/details``，不回显敏感输入。",
        "properties": {
          "code": {
            "description": "稳定错误码，见 core.errors.ErrorCode",
            "maxLength": 64,
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "面向用户的可读信息",
            "maxLength": 500,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "maxLength": 64,
            "title": "Request Id",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "PreferenceMode": {
        "description": "资源形态偏好。",
        "enum": [
          "text_first",
          "video_first",
          "mixed",
          "both"
        ],
        "title": "PreferenceMode",
        "type": "string"
      },
      "PrefsSnapshot": {
        "additionalProperties": false,
        "description": "资源偏好快照（请求内联，非独立资源）。",
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/PreferenceMode",
            "default": "mixed"
          },
          "language": {
            "default": "zh",
            "maxLength": 16,
            "title": "Language",
            "type": "string"
          },
          "official_priority": {
            "default": true,
            "title": "Official Priority",
            "type": "boolean"
          },
          "pace": {
            "default": "normal",
            "enum": [
              "slow",
              "normal",
              "fast"
            ],
            "title": "Pace",
            "type": "string"
          }
        },
        "title": "PrefsSnapshot",
        "type": "object"
      },
      "AiRunNextAction": {
        "description": "前端据此渲染下一步按钮。前端**永不**看到图内部节点名。",
        "enum": [
          "none",
          "review_draft",
          "retry",
          "reconcile",
          "wait"
        ],
        "title": "AiRunNextAction",
        "type": "string"
      },
      "AiRunStatus": {
        "description": "对外可授权的运行状态。\n\n图跑成功 **不自动等于**知识已学会、任务已验收。",
        "enum": [
          "queued",
          "running",
          "waiting_user",
          "succeeded",
          "failed",
          "cancelled",
          "reconciliation_required"
        ],
        "title": "AiRunStatus",
        "type": "string"
      },
      "RunView": {
        "description": "对外运行状态投影（**唯一**可授权给前端的运行视图）。\n\n``status`` 成功 **不自动等于** 知识已学会/任务已验收。\n``result_ref`` 是不透明引用；前端不得解析其内部结构。",
        "properties": {
          "run_id": {
            "maxLength": 64,
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AiRunStatus"
          },
          "next_action": {
            "$ref": "#/components/schemas/AiRunNextAction"
          },
          "version": {
            "description": "乐观并发版本号",
            "minimum": 1,
            "title": "Version",
            "type": "integer"
          },
          "result_ref": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Ref"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "run_id",
          "status",
          "next_action",
          "version"
        ],
        "title": "RunView",
        "type": "object"
      },
      "PlanGenerateRequest": {
        "additionalProperties": false,
        "properties": {
          "goal": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "prefs_snapshot": {
            "$ref": "#/components/schemas/PrefsSnapshot"
          }
        },
        "required": [
          "goal"
        ],
        "title": "PlanGenerateRequest",
        "type": "object"
      },
      "PlanGenerateResponse": {
        "description": "202 响应：只返回运行句柄，不返回草案内容。",
        "properties": {
          "run_id": {
            "maxLength": 64,
            "title": "Run Id",
            "type": "string"
          },
          "status_url": {
            "maxLength": 200,
            "title": "Status Url",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status_url"
        ],
        "title": "PlanGenerateResponse",
        "type": "object"
      },
