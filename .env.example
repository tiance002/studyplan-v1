# ============================================================
# studyplan 环境变量模板
# 复制为 .env 后填写真实值。.env 永不入库。
# 本文件使用占位值，不包含任何旧工程 secret。
# ============================================================

# ---- app ----
APP_ENV=development
APP_NAME=studyplan
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ---- business database (studyplan_app) ----
# 业务事实源：领域表。与 checkpoint 库物理隔离。
DATABASE_URL=postgresql+asyncpg://studyplan_app:CHANGE_ME@127.0.0.1:5432/studyplan_app
DATABASE_URL_SYNC=postgresql+psycopg://studyplan_app:CHANGE_ME@127.0.0.1:5432/studyplan_app

# ---- checkpoint database (studyplan_checkpoint, 独立库/独立角色) ----
# 只保存 LangGraph 工作流执行位置，不存业务事实。
CHECKPOINT_DATABASE_URL=postgresql://studyplan_checkpoint:CHANGE_ME@127.0.0.1:5432/studyplan_checkpoint

# ---- auth / session ----
SESSION_SECRET=CHANGE_ME_random_64_hex
SESSION_COOKIE_NAME=studyplan_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=1209600
CSRF_ENABLED=true
ALLOW_ORIGINS=http://localhost:5173

# ---- llm provider (云模型先行；Fake 仅用于测试) ----
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL_ID=CHANGE_ME
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=8192
LLM_OUTLINE_OUTPUT_TOKENS=4096
LLM_STRUCTURE_OUTPUT_TOKENS=8192
LLM_PRACTICE_OUTPUT_TOKENS=4096
LLM_REPAIR_OUTPUT_TOKENS=8192
# Required for OpenAI-compatible models other than the recognized DeepSeek Flash model.
LLM_MODEL_MAX_OUTPUT_TOKENS=8192
LLM_ALLOWED_HOSTS=api.openai.com,api.deepseek.com
# Fernet key for user model credentials. Generate once and keep only in deployment secrets.
MODEL_SETTINGS_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# ---- external adapters ----
GITHUB_TOKEN=CHANGE_ME
# Tavily is the selected search provider. Set the real key privately in .env.
# User-triggered basic search; durable global-per-database request cap (maximum 1000).
# The current acceptance journal separately enforces cumulative usage across test databases.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=CHANGE_ME
SEARCH_REQUEST_LIMIT=1000
# Anonymous public repository discovery, independently selectable from Tavily.
# No OAuth token is required for this public-only entry.
GITHUB_DISCOVERY_ENABLED=true
# Persisted reservation caps. One inspection reserves up to three content/two metadata slots.
# Cross-database acceptance quotas additionally use an append-only external ledger.
RESOURCE_CONTENT_REQUEST_LIMIT=3000
RESOURCE_METADATA_REQUEST_LIMIT=2000
RAG_BASE_URL=http://127.0.0.1:8100
RAG_API_KEY=CHANGE_ME
RAG_TIMEOUT_SECONDS=10

# ---- worker / queue ----
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
# trusted_server claims jobs for registered users through the scoped atomic DB function.
# allowlist is retained for controlled legacy harnesses only.
PLANNING_WORKER_ADMISSION_MODE=trusted_server
PLANNING_WORKER_ACTOR_IDS=

# ---- planning graph limits ----
GRAPH_MAX_REPAIR_ATTEMPTS=2
# The one official generation protocol. Do not set a legacy value: a run's stored
# version is never re-explained by another protocol, and unknown values are refused.
GRAPH_VERSION=b3f2-short-v2

# ---- langgraph ----
# 必须在 import langgraph 之前设置，关闭 pickle fallback
LANGGRAPH_STRICT_MSGPACK=true

# 历史 B3 脚本参数；B3-F1 普通浏览器只使用持久密码会话，不消费这些本地令牌。
STUDYPLAN_LOCAL_SESSION_TOKEN=CHANGE_ME_random_opaque_token
STUDYPLAN_LOCAL_ACTOR_ID=b3_local_actor
STUDYPLAN_LOCAL_PROJECT_ID=b3_local_project
# 迁移/播种凭据仅供安装命令使用；不能作为请求路径业务角色。
STUDYPLAN_MIGRATION_DSN=postgresql://studyplan_migrator:CHANGE_ME@127.0.0.1:5432/studyplan_app
CHECKPOINT_SETUP_DSN=postgresql://studyplan_migrator:CHANGE_ME@127.0.0.1:5432/studyplan_checkpoint
